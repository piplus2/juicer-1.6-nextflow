manifest {
    name            = "Juicer1.6"
    author          = "Paolo Inglese"
    homePage        = "https://github.com/piplus2/juicer-1.6-nextflow"
    description     = "Juicer 1.6 pipeline for HiChIP-seq data"
    mainScript      = "main.nf"
    nextflowVersion = ">=23.04.0"
    version         = '0.0.1'
}

includeConfig "conf/modules.config"


params {

    // Input
    input                  = null

    // References
    reference              = null
    genome_id              = null
    genomeID               = null

    // HiChIP options
    site                   = 'none'
    site_file              = null
    ligation               = null
    nofrag                 = true
    justexact              = false

    // HIC options
    resolutions            = '2500000,1000000,500000,250000,100000,50000,25000,10000,5000,2000,1000,500,200,100'

    // Postprocessing options
    skip_motif_finder      = false

    // Mapping params
    mapq                   = 30

    // Directories
    outdir                 = null
    motif_dir              = null
    
    // Misc options
    about                  = 'nextflow/juicer run'
    juicer_version         = '1.6'
    threads                = 16
    java_mem               = '64g'
    save_merged_nodups_bam = true
    
    conda_use_mamba        = true
    conda_cache_dir        = null
    singularity_cache_dir  = null
    hpc_queue              = 'workq'
    smallcpu_cpus          = null
    smallcpu_memory_gb     = null
    smallcpu_time          = null
    mediumcpu_cpus         = null
    mediumcpu_memory_gb    = null
    mediumcpu_time         = null
    highcpu_cpus           = null
    highcpu_memory_gb      = null
    highcpu_time           = null
    highmemory_cpus        = null
    highmemory_memory_gb   = null
    highmemory_time        = null
    gpu_cpus               = null
    gpu_memory_gb          = null
    gpu_time               = null
    gpu_cluster_options    = null
    use_gpu                = true

}

params.ligation_map = {
    if (params.ligation) {
        return params.ligation
    }
    def ligationMap = [
        'hindiii': "AAGCTAGCTT",
        'dpnii': "GATCGATC",
        'mboi': "GATCGATC",
        'ncoi': "CCATGCATGG",
        'arima': "'(GAATAATC|GAATACTC|GAATAGTC|GAATATTC|GAATGATC|GACTAATC|GACTACTC|GACTAGTC|GACTATTC|GACTGATC|GAGTAATC|GAGTACTC|GAGTAGTC|GAGTATTC|GAGTGATC|GATCAATC|GATCACTC|GATCAGTC|GATCATTC|GATCGATC|GATTAATC|GATTACTC|GATTAGTC|GATTATTC|GATTGATC)'",
        'none': "XXXX",
    ]
    if (!params.site) {
        System.err.println("No restriction site specified, using default value: 'none: XXXX'")
        return ligationMap['none']
    }
    return ligationMap[params.site.toLowerCase()]
}.call()

profiles {

    pbs {
        includeConfig "conf/base.config"
        includeConfig "conf/pbs.config"
    }

    test {
        includeConfig "conf/base.config"
        includeConfig "conf/test.config"
    }

    conda {
        includeConfig "conf/conda.config"
    }

    singularity {
        includeConfig "conf/singularity.config"
    }
}
